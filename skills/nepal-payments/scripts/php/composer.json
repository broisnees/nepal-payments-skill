{
    "name": "broisnees/nepal-payments",
    "description": "Reference adapters for Nepali payment providers: eSewa, Khalti, Fonepay, connectIPS, CyberSource, NPS, IME Pay, NEPALPAY QR, Hamro Pay, GetPay. Zero runtime Composer dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["esewa", "khalti", "fonepay", "connectips", "cybersource", "nps", "imepay", "nepalpay", "hamropay", "getpay", "nepal", "payments"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "NepalPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NepalPayments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "sandbox": "php tests/sandbox.php"
    },
    "config": {
        "sort-packages": true
    }
}
