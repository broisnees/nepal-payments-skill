---
// Blog article: the landing page's nav and footer around a reading column and a sticky table of contents.
import type { MarkdownHeading } from "astro";
import Landing from "./Landing.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StackPicker from "../components/blog/StackPicker.astro";
import Icon from "../components/Icon.astro";
import { INSTALL, SITE_NAME } from "../data/site";
import { DEFAULT_FW, frameworks, fwName, stackRedirectScript, stackUrl } from "../data/stacks";
import type { Post } from "../data/blog";
import "../styles/blog.css";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  minutes: number;
  related: Post[];
  /** Framework this page shows code for. */
  stack: string;
}

const { post, headings, minutes, related, stack: fw } = Astro.props;
const { label, published, updated, faq, stack } = post.data;
// Framework pages get their own title and description, so "esewa laravel" finds the Laravel page.
const isDefault = fw === DEFAULT_FW;
const fill = (s: string | undefined) => s?.replaceAll("{stack}", fwName(fw));
const title = (!isDefault && fill(post.data.stackTitle)) || post.data.title;
const description = (!isDefault && fill(post.data.stackDescription)) || post.data.description;
const url = new URL(stack ? stackUrl(post.id, fw) : `/blog/${post.id}/`, Astro.site).href;
const modified = updated ?? published;
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const toc = [...headings.filter((h) => h.depth === 2), ...(faq.length ? [{ depth: 2, slug: "faq", text: "FAQ" }] : [])];
const org = { "@type": "Organization", name: SITE_NAME, url: new URL("/", Astro.site).href };

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: published.toISOString(),
    dateModified: modified.toISOString(),
    inLanguage: "en",
    image: new URL("/og.png", Astro.site).href,
    author: org,
    publisher: org,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Blog", item: new URL("/blog/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: title, item: url },
    ],
  },
  ...(faq.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
        },
      ]
    : []),
];
---

<Landing title={`${title} · ${SITE_NAME}`} description={description} jsonLd={jsonLd} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={published.toISOString()} />
    <meta property="article:modified_time" content={modified.toISOString()} />
    {stack && isDefault && <script is:inline set:html={stackRedirectScript(post.id)} />}
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>
  <SiteNav current="blog" />

  <main id="main" class="article-shell container">
    <article class="article">
      <header class="article-head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a><span aria-hidden="true">/</span>
          {stack && !isDefault ? <a href={`/blog/${post.id}/`}>{label}</a> : <span>{label}</span>}
          {stack && !isDefault && (<><span aria-hidden="true">/</span><span>{fwName(fw)}</span></>)}
        </nav>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="meta">
          <time datetime={modified.toISOString()}>{updated ? `Updated ${fmt(updated)}` : fmt(published)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
        {stack && <StackPicker postId={post.id} current={fw} />}
      </header>

      <details class="toc-mobile">
        <summary>On this page</summary>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>

      <div class="prose">
        <slot />

        {
          faq.length > 0 && (
            <section class="faq" aria-labelledby="faq">
              <h2 id="faq">FAQ</h2>
              {faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </section>
          )
        }
      </div>

      {
        stack && (
          <nav class="other-stacks" aria-labelledby="other-stacks-title">
            <h2 id="other-stacks-title">This guide in other frameworks</h2>
            <ul>
              {frameworks.map((f) => (
                <li>
                  <a href={stackUrl(post.id, f.id)} aria-current={f.id === fw ? "page" : undefined}>{f.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <section class="article-cta">
        <h2>Let your coding agent write it</h2>
        <p>
          The Nepal Payments skill adds this integration to your app with tested adapters in six languages, the payment
          state machine and reconciliation.
        </p>
        <code class="cta-cmd">{INSTALL}</code>
        <a class="text-link" href="/docs/install/">Read the install guide<Icon name="chevron" size={14} /></a>
      </section>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">More integration guides</h2>
            <ul class="guides">
              {related.map((p) => (
                <li>
                  <a href={`/blog/${p.id}/`}>
                    <span class="mono guide-label">{p.data.label}</span>
                    <span class="guide-title">{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>

    <aside class="toc" aria-label="On this page">
      <p class="toc-title">On this page</p>
      <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
    </aside>
  </main>

  <SiteFooter />
</Landing>

<script>
  // Highlight the section being read. One observer, no scroll listener.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]));
  const seen = new Set<string>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id);
      const current = [...links.keys()].find((id) => seen.has(id));
      if (!current) return;
      for (const [id, a] of links) a.toggleAttribute("aria-current", id === current);
    },
    { rootMargin: "-80px 0px -60% 0px" },
  );
  for (const id of links.keys()) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }
</script>
