---
import { Code } from "astro:components";
import Landing from "../layouts/Landing.astro";
import Icon from "../components/Icon.astro";
import CopyButton from "../components/CopyButton.astro";
import Feature from "../components/Feature.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getPosts } from "../data/blog";
import GatewayLogo from "../components/GatewayLogo.astro";
import {
  REPO,
  INSTALL,
  AGENT_PROMPT,
  providers,
  languages,
  totalTests,
  signing,
  transitions,
  frameworks,
  agents,
  workflow,
  snippets,
  faqs,
} from "../data/site";

const title = "Nepal Payments: eSewa, Khalti and Fonepay for coding agents";
const description = `An Agent Skill with tested adapters for eSewa, Khalti, Fonepay, connectIPS, CyberSource, NPS and IME Pay in six languages. ${totalTests} tests, zero runtime dependencies.`;

const site = new URL("/", Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "Nepal Payments",
    description,
    url: site,
    codeRepository: REPO,
    license: "https://opensource.org/licenses/MIT",
    programmingLanguage: languages.map((l) => l.name),
    keywords: ["Nepal payments", "eSewa", "Khalti", "Fonepay", "connectIPS", "CyberSource", "NPS", "IME Pay", "Agent Skill", "payment gateway"],
    author: { "@type": "Person", name: "Nischal Dahal" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

// The mock attempt below uses the exact values from the eSewa verify test (scripts/ts/test/adapters.test.ts).
const trace = [
  { step: "esewa.initiate()", note: "signed form · total_amount=1000", from: 0, to: 14, kind: "server" },
  { step: "payer on eSewa", note: "rc-epay.esewa.com.np", from: 14, to: 62, kind: "provider" },
  { step: "return ?data=…", note: "untrusted hint", from: 62, to: 66, kind: "browser" },
  { step: "parseSuccess()", note: "HMAC-SHA256 · valid", from: 66, to: 70, kind: "server" },
  { step: "status API", note: "COMPLETE · ref 0001TS9", from: 70, to: 88, kind: "provider" },
  { step: "decideTransition()", note: "initiated → paid", from: 88, to: 91, kind: "server" },
  { step: "fulfil()", note: "exactly once", from: 91, to: 96, kind: "server" },
];

const files = [
  { name: "core.ts", added: true },
  { name: "esewa.ts", added: true, active: true },
  { name: "khalti.ts", added: true },
  { name: "index.ts", added: true },
];

const recon = [
  { id: "P1KX3M9Q2Z", provider: "khalti", was: "pending", now: "paid", tone: "ok" },
  { id: "P1KX3N0A7C", provider: "esewa", was: "initiated", now: "wait", tone: "muted" },
  { id: "P1KX3N4D2Q", provider: "nps", was: "pending", now: "backoff", tone: "muted" },
  { id: "P1KX3P8B1M", provider: "fonepay", was: "unknown", now: "alert", tone: "warn" },
];

const secrets = [
  { name: "ESEWA_SECRET_KEY", where: "server env" },
  { name: "KHALTI_SECRET_KEY", where: "server env" },
  { name: "FONEPAY_SECRET_KEY", where: "server env" },
  { name: "CONNECTIPS_PRIVATE_KEY_PEM", where: "server env" },
];

const posts = await getPosts();
---

<Landing title={title} description={description} jsonLd={jsonLd}>
  <a class="skip" href="#main">Skip to content</a>

  <div class="announce">
    <a href={REPO} rel="noopener">Nepal Payments is open source under MIT. <span class="u">Star it on GitHub</span><Icon name="external" size={13} /></a>
  </div>

  <SiteNav />

  <main id="main">
    <!-- Hero -->
    <section class="hero container">
      <div class="badge">
        <span class="badge-mark">{totalTests}</span>
        <span class="badge-text">
          <span>Tests across six languages</span>
          <span class="mono">PROVIDER VECTORS · SANDBOX CHECKED</span>
        </span>
      </div>

      <div class="split hero-split">
        <h1>Nepali payments for coding agents</h1>
        <p class="lede">
          One Agent Skill teaches Claude Code, Codex and Cursor to integrate eSewa, Khalti, Fonepay, connectIPS, CyberSource,
          NPS and IME Pay. It ships tested adapters in six languages, so the agent copies working code instead of guessing.
        </p>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/docs/install/">Install the skill</a>
        <CopyButton text={AGENT_PROMPT} label="Copy agent prompt" class="btn-lg" />
      </div>
      <p class="fineprint">
        Free and MIT licensed. Works with any agent that reads Agent Skills, or copy the adapters by hand.{" "}
        <a href="/docs/adapters/">Use without an agent</a>.
      </p>

      <!-- Product mock: one eSewa attempt, verified end to end -->
      <div class="app" role="img" aria-label="Example: an eSewa payment attempt verified on the server, from initiate to fulfil">
        <aside class="app-side">
          <div class="app-ws">shop-api <Icon name="down" size={14} /></div>
          <p class="app-label">Skill</p>
          <div class="app-item"><Icon name="file" size={15} />SKILL.md</div>
          <div class="app-item"><Icon name="folder" size={15} />references</div>
          <p class="app-label">src/server/payments</p>
          {files.map((f) => (
            <div class:list={["app-item", "indent", { active: f.active }]}>
              <Icon name="file" size={15} />{f.name}{f.added && <span class="app-added">new</span>}
            </div>
          ))}
          <div class="app-item"><Icon name="file" size={15} />routes/payments.ts</div>
          <div class="app-item"><Icon name="file" size={15} />0003_payment_attempts.sql</div>
          <div class="app-foot"><Icon name="terminal" size={14} />49 passed · tsc clean</div>
        </aside>

        <div class="app-main">
          <div class="app-crumbs">
            <span class="muted">Attempts</span><Icon name="chevron" size={13} class="muted" />
            <span>ORD-2</span>
            <span class="pill ok">paid</span>
            <span class="mono muted hide-sm">esewa · EPAYTEST</span>
          </div>
          <div class="app-tabs"><span class="on">Lifecycle</span><span>Callback</span><span>Raw</span></div>
          <div class="app-table">
            <div class="row head"><span>Step</span><span class="hide-sm">Detail</span><span class="bar-col">Timeline</span></div>
            {trace.map((t, i) => (
              <div class:list={["row", { sel: i === 4 }]}>
                <span class="step"><span class:list={["kind", t.kind]}></span>{t.step}</span>
                <span class="mono muted hide-sm">{t.note}</span>
                <span class="bar-col"><span class:list={["bar", t.kind]} style={`margin-inline-start:${t.from}%;width:${t.to - t.from}%`}></span></span>
              </div>
            ))}
          </div>
        </div>

        <aside class="app-detail">
          <div class="app-detail-head">
            <span class="app-ico"><Icon name="shield" size={15} /></span>
            <span><strong>status API</strong><span class="mono muted">GET · 200</span></span>
          </div>
          <div class="kv-group">
            <p class="kv-title">VerifyResult</p>
            <dl class="kv">
              <div><dt>status</dt><dd><span class="pill ok">paid</span></dd></div>
              <div><dt>amountPaisa</dt><dd class="mono">100000</dd></div>
              <div><dt>transactionId</dt><dd class="mono">0001TS9</dd></div>
              <div><dt>signatureValid</dt><dd class="mono">true</dd></div>
            </dl>
          </div>
          <div class="kv-group">
            <p class="kv-title">Request</p>
            <p class="mono url">rc.esewa.com.np/api/epay/transaction/status/?product_code=EPAYTEST&amp;total_amount=1000&amp;transaction_uuid=ORD-2</p>
          </div>
          <div class="kv-group">
            <p class="kv-title">Amount check</p>
            <dl class="kv">
              <div><dt>stored</dt><dd class="mono">100000</dd></div>
              <div><dt>provider</dt><dd class="mono">100000</dd></div>
            </dl>
          </div>
        </aside>
      </div>
    </section>

    <!-- Gateways -->
    <section class="container gw-strip" aria-label="Supported gateways">
      <p class="gw-strip-title">Works with every major Nepali gateway</p>
      <ul>{providers.map((p) => <li><a href={`/docs/providers/${p.slug}/`} title={p.name}><GatewayLogo slug={p.slug} name={p.name} height={26} /></a></li>)}</ul>
    </section>

    <!-- Features -->
    <section class="section container" id="providers" aria-labelledby="features-title">
      <div class="split section-head">
        <h2 id="features-title">Sign it right. Verify it on the server.</h2>
        <p>Every rule your agent would otherwise guess at, checked against each provider's own test vectors.</p>
      </div>

      <div class="features">
        <Feature
          wide
          tone="lavender"
          title="A redirect is not a payment"
          body="The return URL is a hint anyone can hit. The adapter checks the callback signature, asks the provider's status API, and compares the amount with the one you stored."
          href="/docs/guides/architecture/"
          link="See the architecture"
        >
          <div class="panel">
            <div class="panel-bar"><span class="muted">Verify</span><Icon name="chevron" size={13} class="muted" /><span>ORD-2</span><span class="mono muted push">esewa · sandbox</span></div>
            <div class="ptable cols-3">
              <div class="row head"><span>Check</span><span>Source</span><span class="end">Result</span></div>
              <div class="row"><span>Callback data</span><span class="mono muted">?data=eyJ0cmFu…</span><span class="end mono">decoded</span></div>
              <div class="row"><span>Signature</span><span class="mono muted">HMAC-SHA256</span><span class="end mono ok-t">valid</span></div>
              <div class="row sel"><span>Status API</span><span class="mono muted">transaction/status</span><span class="end mono ok-t">COMPLETE</span></div>
              <div class="row"><span>Amount</span><span class="mono muted">stored 100000</span><span class="end mono ok-t">match</span></div>
              <div class="row"><span>Transition</span><span class="mono muted">decideTransition</span><span class="end mono">initiated → paid</span></div>
            </div>
            <div class="panel-foot">
              <div><span class="muted">Order</span><span class="mono">ORD-2</span></div>
              <div><span class="muted">Amount</span><span class="mono">Rs 1,000</span></div>
              <div><span class="muted">Reference</span><span class="mono">0001TS9</span></div>
            </div>
          </div>
        </Feature>

        <Feature
          tone="sky"
          title="Signatures that match"
          body="Field order and encoding differ per gateway. Each scheme is pinned by the provider's own test vectors."
          href="/docs/providers/esewa/"
          link="Provider references"
        >
          <div class="panel">
            <div class="panel-bar"><span class="muted">Adapters</span><Icon name="chevron" size={13} class="muted" /><span>Signing</span></div>
            <div class="ptable cols-3">
              <div class="row head"><span>Provider</span><span>Scheme</span><span class="end">Output</span></div>
              {signing.map((s) => (
                <div class="row"><span>{s.provider}</span><span class="mono">{s.scheme}</span><span class="end mono muted">{s.encoding}</span></div>
              ))}
            </div>
          </div>
        </Feature>

        <Feature
          tone="rose"
          title="Fulfil exactly once"
          body="One pure function decides every status change, including late payments and mismatched amounts."
          href="/docs/api/#decidetransition"
          link="See decideTransition"
        >
          <div class="panel">
            <div class="panel-bar"><span class="muted">State machine</span><Icon name="chevron" size={13} class="muted" /><span>Tested cases</span></div>
            <div class="ptable cols-3">
              <div class="row head"><span>Stored</span><span>Provider says</span><span class="end">Writes</span></div>
              {transitions.map((t) => (
                <div class="row"><span class="mono">{t.prev}</span><span class="mono muted">{t.says}</span><span class:list={["end", "mono", `${t.tone}-t`]}>{t.next}</span></div>
              ))}
            </div>
          </div>
        </Feature>

        <Feature
          tone="mint"
          title="Six languages, one interface"
          body="The same providers and the same tests in each, with no runtime dependencies."
          href="/docs/languages/"
          link="See languages"
        >
          <div class="panel light">
            <div class="panel-bar"><span class="muted">scripts</span><Icon name="chevron" size={13} class="muted" /><span>Adapters</span><span class="mono muted push">{totalTests} tests</span></div>
            <div class="ptable cols-3">
              <div class="row head"><span>Language</span><span>Path</span><span class="end">Tests</span></div>
              {languages.map((l) => (
                <div class="row"><span>{l.name}</span><span class="mono muted trunc">{l.path.replace("scripts/", "")}</span><span class="end mono">{l.tests}</span></div>
              ))}
            </div>
          </div>
        </Feature>

        <Feature
          tone="slate"
          title="Settle abandoned payments"
          body="Customers pay and close the tab. A job re-checks open attempts and settles them."
          href="/docs/guides/architecture/#6-reconciliation-job"
          link="See reconciliation"
        >
          <div class="panel light">
            <div class="panel-bar"><span>Reconciliation</span><span class="mono muted push">every 1-5 min</span></div>
            <div class="ptable cols-3">
              <div class="row head"><span>Provider</span><span>Was</span><span class="end">Now</span></div>
              {recon.map((r) => (
                <div class="row"><span class="mono">{r.provider}</span><span class="mono muted">{r.was}</span><span class:list={["end", "mono", `${r.tone}-t`]}>{r.now}</span></div>
              ))}
            </div>
            <p class="panel-note muted">Sample rows. Open statuses older than 2 minutes, bounded concurrency.</p>
          </div>
        </Feature>

        <Feature
          tone="steel"
          title="Keep secrets on the server"
          body="Clients send an order id. Signing keys never reach the browser or the app."
          href="/docs/guides/env/"
          link="Environment variables"
        >
          <div class="panel">
            <div class="panel-bar"><span class="muted">Config</span><Icon name="chevron" size={13} class="muted" /><span>Secrets</span></div>
            <div class="ptable cols-3">
              <div class="row head"><span>Variable</span><span>Lives in</span><span class="end">Client</span></div>
              {secrets.map((s) => (
                <div class="row"><span class="mono trunc">{s.name}</span><span class="mono muted">{s.where}</span><span class="end"><span class="toggle" aria-label="not exposed"></span></span></div>
              ))}
            </div>
            <div class="panel-foot"><div><span class="muted">Client sends</span><span class="mono">orderId</span></div></div>
          </div>
        </Feature>

        <Feature
          tone="cream"
          title="Install in any agent"
          body="The plugin marketplace for Claude Code, the skills CLI for everything else."
          href="/docs/install/"
          link="Read the install guide"
        >
          <div class="panel">
            <div class="panel-bar"><span class="muted">Setup</span><Icon name="chevron" size={13} class="muted" /><span>Install</span></div>
            <div class="ptable cols-2">
              <div class="row head"><span>Agent</span><span class="end">Command</span></div>
              <div class="row"><span>Claude Code</span><span class="end mono trunc">/plugin install nepal-payments</span></div>
              <div class="row"><span>Codex, Cursor</span><span class="end mono trunc">npx skills add …</span></div>
              <div class="row"><span>Gemini CLI, Copilot</span><span class="end mono trunc">npx skills add …</span></div>
              <div class="row sel"><span>Manual</span><span class="end mono trunc">cp -r skills/nepal-payments</span></div>
            </div>
            <div class="panel-foot"><div><span class="muted">Format</span><span class="mono">Agent Skills</span></div><div><span class="muted">License</span><span class="mono">MIT</span></div></div>
          </div>
        </Feature>
      </div>
    </section>

    <!-- Integration guides -->
    <section class="section container" id="guides" aria-labelledby="guides-title">
      <div class="split section-head">
        <h2 id="guides-title">Integration guides</h2>
        <p>One guide per gateway: signing code in Node.js, Laravel and Django, sandbox logins and the error codes you will hit.</p>
      </div>
      <ul class="guides">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              {p.data.provider ? <span class="guide-logo"><GatewayLogo slug={p.data.provider} name={p.data.label} height={18} /></span> : <span class="mono guide-label">{p.data.label}</span>}
              <span class="guide-title">{p.data.title}</span>
              <span class="guide-more">Read the guide<Icon name="chevron" size={14} /></span>
            </a>
          </li>
        ))}
      </ul>
      <a class="text-link center" href="/blog/">All guides<Icon name="chevron" size={14} /></a>
    </section>

    <!-- Code -->
    <section class="section container" aria-labelledby="code-title">
      <div class="split section-head">
        <h2 id="code-title">Two calls, any stack</h2>
        <p>Copy the folder for your language. Start with <code>initiate</code>, confirm with <code>verify</code>, and keep money in integer paisa.</p>
      </div>
      <div class="code-box" data-tabs>
        <div class="code-tabs" role="tablist" aria-label="Language">
          {snippets.map((s, i) => (
            <button type="button" role="tab" id={`tab-${s.lang}`} aria-controls={`panel-${s.lang}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              {s.label}
            </button>
          ))}
          <a class="code-more" href="/docs/adapters/">Adapter guide<Icon name="chevron" size={14} /></a>
        </div>
        {snippets.map((s, i) => (
          <div class="code-panel" role="tabpanel" id={`panel-${s.lang}`} aria-labelledby={`tab-${s.lang}`} hidden={i !== 0}>
            <Code code={s.code} lang={s.lang} themes={{ light: "vitesse-light", dark: "vitesse-dark" }} defaultColor={false} />
          </div>
        ))}
      </div>
    </section>

    <!-- Start building -->
    <section class="section container" aria-labelledby="start-title">
      <div class="split section-head">
        <h2 id="start-title">Start building</h2>
        <p>Give the prompt to your coding agent, or open the guide for the stack that you use.</p>
      </div>

      <div class="start">
        <div class="start-first">
          <h3>Integrate in one prompt</h3>
          <p class="mono sub">One prompt for your coding agent</p>
          <ol>
            {workflow.map((w, i) => <li><span class="mono">{String(i + 1).padStart(2, "0")}</span>{w}</li>)}
          </ol>
          <CopyButton text={AGENT_PROMPT} label="Copy agent prompt" variant="primary" class="btn-block" />
          <a class="text-link center" href="/docs/usage/">Or read the usage guide<Icon name="chevron" size={14} /></a>
        </div>
        <div class="start-col">
          <h3>Providers <span class="count">{providers.length}</span></h3>
          <p class="sub">Wallets, banks and cards.</p>
          <ul class="logo-list">{providers.map((p) => <li><a href={`/docs/providers/${p.slug}/`}><GatewayLogo slug={p.slug} name={p.name} height={16} /><span class="sr-only">{p.name}</span></a></li>)}</ul>
        </div>
        <div class="start-col">
          <h3>Frameworks <span class="count">{frameworks.length}</span></h3>
          <p class="sub">Routes wired for you.</p>
          <ul>{frameworks.map((f) => <li><a href="/docs/guides/web/"><span class="sq"></span>{f}</a></li>)}</ul>
        </div>
        <div class="start-col">
          <h3>Languages <span class="count">{languages.length}</span></h3>
          <p class="sub">Adapters you can copy.</p>
          <ul>{languages.map((l) => <li><a href="/docs/languages/"><span class="sq"></span>{l.name}</a></li>)}</ul>
        </div>
        <div class="start-col split-col">
          <div>
            <h3>Coding agents <span class="count">{agents.length}</span></h3>
            <p class="sub">Anything that reads skills.</p>
            <ul>{agents.map((a) => <li><a href="/docs/install/"><span class="sq"></span>{a}</a></li>)}</ul>
          </div>
          <div class="start-note">
            <p>Not on the list? Any agent that supports the Agent Skills format works.</p>
            <a class="text-link" href="https://agentskills.io" rel="noopener">Agent Skills spec<Icon name="chevron" size={14} /></a>
          </div>
        </div>
      </div>

      <p class="after">
        Already integrated? Paste the failing callback or error code, and the agent checks it against the provider's reference.{" "}
        <a href="/docs/usage/#debugging-with-the-skill">Debug a payment</a>.
      </p>
    </section>

    <!-- FAQ -->
    <section class="section container" aria-labelledby="faq-title">
      <div class="split faq-split">
        <div>
          <h2 id="faq-title">Frequently asked questions</h2>
          <p class="fineprint">Still have a question? <a href={`${REPO}/issues`} rel="noopener">Open an issue</a></p>
        </div>
        <div class="faq">
          {faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <span class="faq-btn" aria-hidden="true"><Icon name="plus" class="i-plus" /><Icon name="minus" class="i-minus" /></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section container" aria-labelledby="cta-title">
      <div class="split section-head">
        <h2 id="cta-title">Take your first sandbox payment</h2>
        <p>eSewa and Fonepay sandboxes need no signup. Install the skill and ask for a checkout.</p>
      </div>
      <div class="cta-grid">
        <div class="cta-card">
          <h3>Install the skill</h3>
          <p>Add it to your project, then describe the integration you want in plain words.</p>
          <div class="cmd" data-tabs>
            <div class="cmd-tabs" role="tablist" aria-label="Install method">
              <button type="button" role="tab" id="tab-cli" aria-controls="panel-cli" aria-selected="true" tabindex="0">skills CLI</button>
              <button type="button" role="tab" id="tab-cc" aria-controls="panel-cc" aria-selected="false" tabindex="-1">Claude Code</button>
            </div>
            <div class="cmd-line" role="tabpanel" id="panel-cli" aria-labelledby="tab-cli">
              <code><span class="muted">$</span> {INSTALL}</code>
              <CopyButton text={INSTALL} label="Copy install command" variant="icon" />
            </div>
            <div class="cmd-line" role="tabpanel" id="panel-cc" aria-labelledby="tab-cc" hidden>
              <code>/plugin install nepal-payments@nepal-payments-skill</code>
              <CopyButton text="/plugin marketplace add broisnees/nepal-payments-skill\n/plugin install nepal-payments@nepal-payments-skill" label="Copy Claude Code commands" variant="icon" />
            </div>
          </div>
          <a class="btn btn-primary btn-lg" href="/docs/install/">Read the install guide</a>
        </div>
        <div class="cta-card">
          <h3>Use the adapters directly</h3>
          <p>No agent needed. Copy the folder for your language, set the environment variables and call initiate and verify.</p>
          <a class="btn btn-secondary btn-lg" href="/docs/adapters/">Adapter guide</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      const status = btn.querySelector<HTMLElement>("[data-copy-status]");
      let timer: number | undefined;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!.replace(/\\n/g, "\n"));
          btn.dataset.copied = "";
          if (status) status.textContent = "Copied";
        } catch {
          if (status) status.textContent = "Copy failed";
        }
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete btn.dataset.copied;
          if (status) status.textContent = "";
        }, 1600);
      });
    }

    for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (tab: HTMLButtonElement) => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
        });
      });
    }
  </script>
</Landing>
