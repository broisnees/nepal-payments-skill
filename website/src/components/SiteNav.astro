---
// Top navigation shared by the landing page and the blog. The platform's public pages use the same bar.
import Icon from "./Icon.astro";
import SettingsMenu from "./SettingsMenu.astro";
import ProductSwitch from "./ProductSwitch.astro";
import { REPO, SITE_NAME } from "../data/site";

interface Props {
  current?: "blog";
}
const { current } = Astro.props;
---

<header class="nav-wrap">
  <nav class="nav container" aria-label="Primary">
    <a class="nav-cell brand" href="/" aria-label={`${SITE_NAME} home`}>
      <img src="/favicon.svg" alt="" width="22" height="22" />
    </a>
    <ProductSwitch />
    <a class="nav-cell hide-sm" href="/docs/">Docs</a>
    <a class="nav-cell hide-sm" href="/blog/" aria-current={current === "blog" ? "page" : undefined}>Blog</a>
    <a class="nav-cell hide-lg" href="/#gateways">Gateways</a>
    <span class="nav-spacer"></span>
    <a class="nav-cell hide-md" href={REPO} rel="noopener"><Icon name="github" />GitHub</a>
    <SettingsMenu variant="nav" />
    <a class="nav-cell nav-cta hide-xs" href="/docs/install/">Install</a>
  </nav>
</header>
