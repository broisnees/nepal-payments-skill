---
// Replaces Starlight's theme <select> with a settings menu: theme submenu, page actions, llms.txt and links.
// Keeps Starlight's storage contract: localStorage "starlight-theme" = "light" | "dark" | "" (system).
interface Props {
  /** "nav": a square, borderless trigger that fills a cell of the landing page nav. */
  variant?: "header" | "nav";
}
const { variant = "header" } = Astro.props;
const repo = "https://github.com/broisnees/nepal-payments-skill";
const path = Astro.url.pathname.replace(/\/$/, "");
const isDoc = path.startsWith("/docs");
const mdUrl = `${path}.md`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ask = encodeURIComponent(`Read ${new URL(mdUrl, Astro.site).href} and help me with it.`);

const icons = {
  settings: '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  updown: '<path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>',
  palette: '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>',
  chevron: '<path d="m9 18 6-6-6-6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  monitor: '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  copy: '<rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
  markdown: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13v4l2-2 2 2v-4"/><path d="M16 13v4"/><path d="m14.5 15.5 1.5 1.5 1.5-1.5"/>',
  sparkles: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/>',
  bot: '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  lifebuoy: '<circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/>',
} as const;
const svg = (name: keyof typeof icons, cls = "") =>
  `<svg class="${cls}" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<np-settings class:list={["np-settings", { "np-nav": variant === "nav" }]}>
  <button type="button" class="np-trigger" aria-haspopup="menu" aria-expanded="false" aria-controls="np-menu">
    <Fragment set:html={svg("settings")} />
    <span class="np-trigger-label">Settings</span>
    <Fragment set:html={svg("updown", "np-updown")} />
  </button>

  <div class="np-menu" id="np-menu" role="menu" aria-label="Settings" hidden>
    <div class="np-group">
      <button type="button" class="np-item np-has-sub" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-sub>
        <Fragment set:html={svg("palette")} /><span>Theme</span><Fragment set:html={svg("chevron", "np-end")} />
      </button>
      <div class="np-sub" role="menu" aria-label="Theme" hidden>
        <button type="button" class="np-item" role="menuitemradio" aria-checked="false" data-theme-choice="light"><Fragment set:html={svg("sun")} /><span>Light</span><Fragment set:html={svg("check", "np-check")} /></button>
        <button type="button" class="np-item" role="menuitemradio" aria-checked="false" data-theme-choice="dark"><Fragment set:html={svg("moon")} /><span>Dark</span><Fragment set:html={svg("check", "np-check")} /></button>
        <button type="button" class="np-item" role="menuitemradio" aria-checked="false" data-theme-choice="auto"><Fragment set:html={svg("monitor")} /><span>System</span><Fragment set:html={svg("check", "np-check")} /></button>
      </div>
    </div>
    {isDoc && (
      <div class="np-group">
        <button type="button" class="np-item" role="menuitem" data-copy-md={mdUrl}><Fragment set:html={svg("copy")} /><span data-label>Copy page as Markdown</span></button>
        <a class="np-item" role="menuitem" href={mdUrl}><Fragment set:html={svg("markdown")} /><span>View as Markdown</span></a>
        <a class="np-item" role="menuitem" href={`https://chatgpt.com/?q=${ask}`} rel="noopener" target="_blank"><Fragment set:html={svg("sparkles")} /><span>Open in ChatGPT</span></a>
        <a class="np-item" role="menuitem" href={`https://claude.ai/new?q=${ask}`} rel="noopener" target="_blank"><Fragment set:html={svg("bot")} /><span>Open in Claude</span></a>
      </div>
    )}
    <div class="np-group">
      <a class="np-item" role="menuitem" href="/llms.txt"><Fragment set:html={svg("file")} /><span>llms.txt</span></a>
      <a class="np-item" role="menuitem" href={repo} rel="noopener"><Fragment set:html={svg("github")} /><span>GitHub</span></a>
      <a class="np-item" role="menuitem" href={`${repo}/issues/new?body=${encodeURIComponent(`Page: ${pageUrl}\n\n`)}`} rel="noopener"><Fragment set:html={svg("lifebuoy")} /><span>Report an issue</span></a>
    </div>
  </div>
</np-settings>

<style>
  .np-settings {
    position: relative;
    display: inline-flex;
    --np-bg: #ffffff;
    --np-border: #e5e5e5;
    --np-text: #171717;
    --np-muted: #737373;
    --np-hover: #f4f4f5;
    --np-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px -8px rgb(0 0 0 / 0.16);
  }

  :global([data-theme="dark"]) .np-settings {
    --np-bg: #1c1c1e;
    --np-border: #2e2e31;
    --np-text: #f4f4f5;
    --np-muted: #a1a1aa;
    --np-hover: #2c2c2f;
    --np-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 16px 40px -8px rgb(0 0 0 / 0.6);
  }

  .np-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding-inline: 10px 8px;
    border: 1px solid var(--np-border);
    border-radius: 10px;
    background: var(--np-bg);
    color: var(--np-text);
    font: 500 14px var(--sl-font);
    cursor: pointer;
    transition-property: background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  .np-trigger:hover,
  .np-trigger[aria-expanded="true"] {
    background: var(--np-hover);
  }

  .np-trigger:active {
    scale: 0.96;
  }

  .np-nav {
    align-items: stretch;
  }

  .np-nav .np-trigger {
    height: auto;
    padding-inline: 18px;
    border: 0;
    border-radius: 0;
    background: var(--bg, var(--np-bg));
    font-weight: 400;
    font-size: 15px;
  }

  .np-nav .np-trigger:active {
    scale: 1;
  }

  .np-trigger :global(.np-updown) {
    width: 15px;
    height: 15px;
    color: var(--np-muted);
  }

  .np-menu,
  .np-sub {
    position: absolute;
    z-index: 100;
    min-width: 236px;
    padding: 6px;
    border: 1px solid var(--np-border);
    border-radius: 14px;
    background: var(--np-bg);
    color: var(--np-text);
    box-shadow: var(--np-shadow);
    transform-origin: top right;
    animation: np-in 140ms cubic-bezier(0.2, 0, 0, 1);
  }

  .np-menu {
    top: calc(100% + 8px);
    inset-inline-end: 0;
  }

  .np-menu[hidden],
  .np-sub[hidden] {
    display: none;
  }

  @keyframes np-in {
    from {
      opacity: 0;
      scale: 0.97;
      translate: 0 -4px;
    }
  }

  .np-group {
    position: relative;
    display: grid;
    gap: 1px;
  }

  .np-group + .np-group {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--np-border);
    margin-inline: -6px;
    padding-inline: 6px;
  }

  .np-sub {
    top: -7px;
    inset-inline-end: calc(100% + 10px);
    min-width: 168px;
    transform-origin: top right;
  }

  .np-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 38px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: 450 14.5px/1 var(--sl-font);
    text-align: start;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .np-item:hover,
  .np-item:focus-visible,
  .np-item[aria-expanded="true"] {
    background: var(--np-hover);
    outline: none;
  }

  .np-item :global(svg) {
    flex: none;
    color: var(--np-text);
  }

  .np-item :global(.np-end),
  .np-item :global(.np-check) {
    margin-inline-start: auto;
    color: var(--np-muted);
  }

  .np-item :global(.np-check) {
    visibility: hidden;
    color: var(--np-text);
  }

  .np-item[aria-checked="true"] :global(.np-check) {
    visibility: visible;
  }

  @media (max-width: 49.99rem) {
    .np-trigger-label {
      display: none;
    }
  }

  /* In Starlight's mobile menu footer the menu opens upward and the submenu stacks above it. */
  :global(.mobile-preferences) .np-menu {
    top: auto;
    bottom: calc(100% + 8px);
    transform-origin: bottom right;
  }

  :global(.mobile-preferences) .np-sub {
    top: auto;
    bottom: calc(100% + 8px);
    inset-inline-end: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .np-menu,
    .np-sub {
      animation: none;
    }
  }
</style>

<script>
  type Choice = "light" | "dark" | "auto";
  const KEY = "starlight-theme";

  const stored = (): Choice => {
    let v: string | null = null;
    try {
      v = localStorage.getItem(KEY);
    } catch {}
    return v === "light" || v === "dark" ? v : "auto";
  };
  const resolve = (c: Choice) => (c === "auto" ? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark") : c);

  function apply(choice: Choice) {
    // Snap instead of cross-fading every element on the page.
    const css = document.createElement("style");
    css.textContent = "*,*::before,*::after{transition:none!important}";
    document.head.appendChild(css);
    document.documentElement.dataset.theme = resolve(choice);
    void getComputedStyle(document.body).opacity;
    requestAnimationFrame(() => css.remove());
    try {
      localStorage.setItem(KEY, choice === "auto" ? "" : choice);
    } catch {}
    for (const el of document.querySelectorAll("[data-theme-choice]")) {
      el.setAttribute("aria-checked", String(el.getAttribute("data-theme-choice") === choice));
    }
  }

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (stored() === "auto") apply("auto");
  });

  class NpSettings extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector<HTMLButtonElement>(".np-trigger")!;
      const menu = this.querySelector<HTMLElement>(".np-menu")!;
      const subBtn = this.querySelector<HTMLButtonElement>("[data-sub]")!;
      const sub = this.querySelector<HTMLElement>(".np-sub")!;
      const items = () => [...menu.querySelectorAll<HTMLElement>(":scope > .np-group > .np-item")];
      const subItems = () => [...sub.querySelectorAll<HTMLElement>(".np-item")];

      for (const el of this.querySelectorAll("[data-theme-choice]")) {
        el.setAttribute("aria-checked", String(el.getAttribute("data-theme-choice") === stored()));
      }

      const openSub = (focus = false) => {
        sub.hidden = false;
        subBtn.setAttribute("aria-expanded", "true");
        if (focus) subItems().find((i) => i.getAttribute("aria-checked") === "true")?.focus() ?? subItems()[0].focus();
      };
      const closeSub = () => {
        sub.hidden = true;
        subBtn.setAttribute("aria-expanded", "false");
      };
      const open = () => {
        menu.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        items()[0].focus();
      };
      const close = (refocus = true) => {
        closeSub();
        menu.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
        if (refocus) trigger.focus();
      };

      trigger.addEventListener("click", () => (menu.hidden ? open() : close()));
      subBtn.addEventListener("click", () => (sub.hidden ? openSub(true) : closeSub()));
      subBtn.addEventListener("pointerenter", () => openSub());
      for (const i of items()) if (i !== subBtn) i.addEventListener("pointerenter", closeSub);

      for (const el of this.querySelectorAll<HTMLElement>("[data-theme-choice]")) {
        el.addEventListener("click", () => {
          apply(el.dataset.themeChoice as Choice);
          close();
        });
      }

      const copy = this.querySelector<HTMLButtonElement>("[data-copy-md]");
      copy?.addEventListener("click", async () => {
        const label = copy.querySelector("[data-label]")!;
        try {
          const text = await (await fetch(copy.dataset.copyMd!)).text();
          await navigator.clipboard.writeText(text);
          label.textContent = "Copied";
        } catch {
          label.textContent = "Copy failed";
        }
        setTimeout(() => {
          label.textContent = "Copy page as Markdown";
          close();
        }, 900);
      });

      menu.addEventListener("keydown", (e) => {
        const inSub = sub.contains(document.activeElement);
        const list = inSub ? subItems() : items();
        const idx = list.indexOf(document.activeElement as HTMLElement);
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          const step = e.key === "ArrowDown" ? 1 : -1;
          list[(idx + step + list.length) % list.length].focus();
        } else if (e.key === "ArrowRight" && !inSub && document.activeElement === subBtn) {
          e.preventDefault();
          openSub(true);
        } else if ((e.key === "ArrowLeft" || e.key === "Escape") && inSub) {
          e.preventDefault();
          closeSub();
          subBtn.focus();
        } else if (e.key === "Escape") {
          close();
        } else if (e.key === "Tab") {
          close(false);
        }
      });

      document.addEventListener("pointerdown", (e) => {
        if (!menu.hidden && !this.contains(e.target as Node)) close(false);
      });
    }
  }
  customElements.define("np-settings", NpSettings);
</script>
