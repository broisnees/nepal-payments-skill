---
// Replaces Starlight's theme <select> with a settings menu: theme submenu, page actions, llms.txt and links.
// Keeps Starlight's storage contract: localStorage "starlight-theme" = "light" | "dark" | "" (system).
interface Props {
  /** "nav": a square, borderless trigger that fills a cell of the landing page nav. */
  variant?: "header" | "nav";
}
import { iconSvg, type IconName } from "../lib/hugeicons";
const { variant = "header" } = Astro.props;
const repo = "https://github.com/broisnees/nepal-payments-skill";
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const svg = (name: IconName, cls = "") => iconSvg(name, 18, cls);
---

<np-settings class:list={["np-settings", { "np-nav": variant === "nav" }]}>
  <button type="button" class="np-trigger" aria-label="Settings" title="Settings" aria-haspopup="menu" aria-expanded="false" aria-controls="np-menu">
    <Fragment set:html={svg("settings")} />
  </button>

  <div class="np-menu" id="np-menu" role="menu" aria-label="Settings" hidden>
    <div class="np-group">
      <button type="button" class="np-item np-has-sub" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-sub>
        <Fragment set:html={svg("palette")} /><span>Theme</span><Fragment set:html={svg("chevron", "np-end")} />
      </button>
      <div class="np-sub" role="menu" aria-label="Theme" hidden>
        <button type="button" class="np-item" role="menuitemradio" aria-checked="false" data-theme-choice="light"><Fragment set:html={svg("sun")} /><span>Light</span><Fragment set:html={svg("check", "np-check")} /></button>
        <button type="button" class="np-item" role="menuitemradio" aria-checked="false" data-theme-choice="dark"><Fragment set:html={svg("moon")} /><span>Dark</span><Fragment set:html={svg("check", "np-check")} /></button>
        <button type="button" class="np-item" role="menuitemradio" aria-checked="false" data-theme-choice="auto"><Fragment set:html={svg("monitor")} /><span>System</span><Fragment set:html={svg("check", "np-check")} /></button>
      </div>
    </div>
    <div class="np-group">
      <a class="np-item" role="menuitem" href="/llms.txt"><Fragment set:html={svg("file")} /><span>llms.txt</span></a>
      <a class="np-item" role="menuitem" href={repo} rel="noopener"><Fragment set:html={svg("github")} /><span>GitHub</span></a>
      <a class="np-item" role="menuitem" href={`${repo}/issues/new?body=${encodeURIComponent(`Page: ${pageUrl}\n\n`)}`} rel="noopener"><Fragment set:html={svg("lifebuoy")} /><span>Report an issue</span></a>
    </div>
  </div>
</np-settings>

<style>
  .np-settings {
    position: relative;
    display: inline-flex;
    --np-bg: #ffffff;
    --np-border: #e5e5e5;
    --np-text: #171717;
    --np-muted: #737373;
    --np-hover: #f4f4f5;
    --np-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px -8px rgb(0 0 0 / 0.16);
  }

  :global([data-theme="dark"]) .np-settings {
    --np-bg: #1c1c1e;
    --np-border: #2e2e31;
    --np-text: #f4f4f5;
    --np-muted: #a1a1aa;
    --np-hover: #2c2c2f;
    --np-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 16px 40px -8px rgb(0 0 0 / 0.6);
  }

  .np-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--np-border);
    border-radius: 0;
    background: var(--np-bg);
    color: var(--np-text);
    font: 500 14px var(--sl-font);
    cursor: pointer;
    transition-property: background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  .np-trigger:hover,
  .np-trigger[aria-expanded="true"] {
    background: var(--np-hover);
  }

  .np-trigger:active {
    scale: 0.96;
  }

  .np-nav {
    align-items: stretch;
  }

  .np-nav .np-trigger {
    height: auto;
    padding-inline: 18px;
    border: 0;
    border-radius: 0;
    background: var(--bg, var(--np-bg));
    font-weight: 400;
    font-size: 15px;
  }

  .np-nav .np-trigger:active {
    scale: 1;
  }

  .np-trigger :global(.np-updown) {
    width: 15px;
    height: 15px;
    color: var(--np-muted);
  }

  .np-menu,
  .np-sub {
    position: absolute;
    z-index: 100;
    min-width: 236px;
    padding: 6px;
    border: 1px solid var(--np-border);
    border-radius: 14px;
    background: var(--np-bg);
    color: var(--np-text);
    box-shadow: var(--np-shadow);
    transform-origin: top right;
    animation: np-in 140ms cubic-bezier(0.2, 0, 0, 1);
  }

  .np-menu {
    top: calc(100% + 8px);
    inset-inline-end: 0;
  }

  .np-menu[hidden],
  .np-sub[hidden] {
    display: none;
  }

  @keyframes np-in {
    from {
      opacity: 0;
      scale: 0.97;
      translate: 0 -4px;
    }
  }

  .np-group {
    position: relative;
    display: grid;
    gap: 1px;
  }

  .np-group + .np-group {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--np-border);
    margin-inline: -6px;
    padding-inline: 6px;
  }

  .np-sub {
    top: -7px;
    inset-inline-end: calc(100% + 10px);
    min-width: 168px;
    transform-origin: top right;
  }

  .np-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 38px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: 450 14.5px/1 var(--sl-font);
    text-align: start;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .np-item:hover,
  .np-item:focus-visible,
  .np-item[aria-expanded="true"] {
    background: var(--np-hover);
    outline: none;
  }

  .np-item :global(svg) {
    flex: none;
    color: var(--np-text);
  }

  .np-item :global(.np-end),
  .np-item :global(.np-check) {
    margin-inline-start: auto;
    color: var(--np-muted);
  }

  .np-item :global(.np-check) {
    visibility: hidden;
    color: var(--np-text);
  }

  .np-item[aria-checked="true"] :global(.np-check) {
    visibility: visible;
  }

  @media (max-width: 49.99rem) {
    .np-trigger-label {
      display: none;
    }
  }

  /* In Starlight's mobile menu footer the menu opens upward and the submenu stacks above it. */
  :global(.mobile-preferences) .np-menu {
    top: auto;
    bottom: calc(100% + 8px);
    transform-origin: bottom right;
  }

  :global(.mobile-preferences) .np-sub {
    top: auto;
    bottom: calc(100% + 8px);
    inset-inline-end: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .np-menu,
    .np-sub {
      animation: none;
    }
  }
</style>

<script>
  type Choice = "light" | "dark" | "auto";
  const KEY = "starlight-theme";

  const stored = (): Choice => {
    let v: string | null = null;
    try {
      v = localStorage.getItem(KEY);
    } catch {}
    return v === "light" || v === "dark" ? v : "auto";
  };
  const resolve = (c: Choice) => (c === "auto" ? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark") : c);

  function apply(choice: Choice) {
    // Snap instead of cross-fading every element on the page.
    const css = document.createElement("style");
    css.textContent = "*,*::before,*::after{transition:none!important}";
    document.head.appendChild(css);
    document.documentElement.dataset.theme = resolve(choice);
    void getComputedStyle(document.body).opacity;
    requestAnimationFrame(() => css.remove());
    try {
      localStorage.setItem(KEY, choice === "auto" ? "" : choice);
    } catch {}
    for (const el of document.querySelectorAll("[data-theme-choice]")) {
      el.setAttribute("aria-checked", String(el.getAttribute("data-theme-choice") === choice));
    }
  }

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (stored() === "auto") apply("auto");
  });

  class NpSettings extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector<HTMLButtonElement>(".np-trigger")!;
      const menu = this.querySelector<HTMLElement>(".np-menu")!;
      const subBtn = this.querySelector<HTMLButtonElement>("[data-sub]")!;
      const sub = this.querySelector<HTMLElement>(".np-sub")!;
      const items = () => [...menu.querySelectorAll<HTMLElement>(":scope > .np-group > .np-item")];
      const subItems = () => [...sub.querySelectorAll<HTMLElement>(".np-item")];

      for (const el of this.querySelectorAll("[data-theme-choice]")) {
        el.setAttribute("aria-checked", String(el.getAttribute("data-theme-choice") === stored()));
      }

      const openSub = (focus = false) => {
        sub.hidden = false;
        subBtn.setAttribute("aria-expanded", "true");
        if (focus) subItems().find((i) => i.getAttribute("aria-checked") === "true")?.focus() ?? subItems()[0].focus();
      };
      const closeSub = () => {
        sub.hidden = true;
        subBtn.setAttribute("aria-expanded", "false");
      };
      const open = () => {
        menu.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        items()[0].focus();
      };
      const close = (refocus = true) => {
        closeSub();
        menu.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
        if (refocus) trigger.focus();
      };

      trigger.addEventListener("click", () => (menu.hidden ? open() : close()));
      subBtn.addEventListener("click", () => (sub.hidden ? openSub(true) : closeSub()));
      subBtn.addEventListener("pointerenter", () => openSub());
      for (const i of items()) if (i !== subBtn) i.addEventListener("pointerenter", closeSub);

      for (const el of this.querySelectorAll<HTMLElement>("[data-theme-choice]")) {
        el.addEventListener("click", () => {
          apply(el.dataset.themeChoice as Choice);
          close();
        });
      }

      const copy = this.querySelector<HTMLButtonElement>("[data-copy-md]");
      copy?.addEventListener("click", async () => {
        const label = copy.querySelector("[data-label]")!;
        try {
          const text = await (await fetch(copy.dataset.copyMd!)).text();
          await navigator.clipboard.writeText(text);
          label.textContent = "Copied";
        } catch {
          label.textContent = "Copy failed";
        }
        setTimeout(() => {
          label.textContent = "Copy page as Markdown";
          close();
        }, 900);
      });

      menu.addEventListener("keydown", (e) => {
        const inSub = sub.contains(document.activeElement);
        const list = inSub ? subItems() : items();
        const idx = list.indexOf(document.activeElement as HTMLElement);
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          const step = e.key === "ArrowDown" ? 1 : -1;
          list[(idx + step + list.length) % list.length].focus();
        } else if (e.key === "ArrowRight" && !inSub && document.activeElement === subBtn) {
          e.preventDefault();
          openSub(true);
        } else if ((e.key === "ArrowLeft" || e.key === "Escape") && inSub) {
          e.preventDefault();
          closeSub();
          subBtn.focus();
        } else if (e.key === "Escape") {
          close();
        } else if (e.key === "Tab") {
          close(false);
        }
      });

      document.addEventListener("pointerdown", (e) => {
        if (!menu.hidden && !this.contains(e.target as Node)) close(false);
      });
    }
  }
  customElements.define("np-settings", NpSettings);
</script>
