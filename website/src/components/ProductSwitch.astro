---
// Skill | Platform | Status: the products side by side, so either site reaches the other in one click.
// Used in the landing/blog nav (variant "nav", fills nav cells) and the Starlight docs header (variant "header").
import { PLATFORM_URL, PLATFORM_NAME, STATUS_URL } from "../data/site";

interface Props {
  variant?: "nav" | "header";
}
const { variant = "nav" } = Astro.props;
---

<div class:list={["ps", `ps-${variant}`]} role="group" aria-label="Products">
  <a class="ps-item" href="/" aria-current="true">Skill</a>
  <a class="ps-item" href={PLATFORM_URL} rel="noopener">Platform<span class="ps-name">{PLATFORM_NAME}</span></a>
  <a class="ps-item" href={STATUS_URL} rel="noopener">Status</a>
</div>

<style>
  /* Plain text items; the product this page belongs to gets ink text and a 2px brand bar. Tokens fall back to
     Starlight's on docs pages. */
  .ps {
    --ps-ink: var(--ink, var(--sl-color-white));
    --ps-muted: var(--muted, var(--sl-color-gray-3));
    --ps-subtle: var(--subtle, var(--sl-color-gray-4));
    --ps-hover: var(--hover, var(--sl-color-gray-6));
    display: flex;
    align-items: stretch;
  }

  .ps-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-inline: 12px;
    font-size: 14px;
    color: var(--ps-muted);
    text-decoration: none;
    white-space: nowrap;
    transition-property: background-color, color;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .ps-item:hover {
      color: var(--ps-ink);
      background: var(--ps-hover);
    }
  }

  .ps-item[aria-current] {
    color: var(--ps-ink);
    font-weight: 500;
  }

  .ps-item[aria-current]::after {
    content: "";
    position: absolute;
    inset-inline: 12px;
    bottom: -1px;
    height: 2px;
    background: var(--brand, #c8102e);
  }

  .ps-name {
    font-size: 12px;
    font-weight: 400;
    color: var(--ps-subtle);
  }

  /* Docs header: same items, sized to Starlight's header controls. */
  .ps-header {
    height: 2.25rem;
  }

  .ps-header .ps-item {
    font-size: var(--sl-text-sm, 14px);
  }

  .ps-header .ps-item[aria-current]::after {
    bottom: 0;
  }

  @media (max-width: 639px) {
    .ps-item {
      padding-inline: 8px;
    }
    .ps-item[aria-current]::after {
      inset-inline: 8px;
    }
    .ps-name {
      display: none;
    }
  }
</style>
