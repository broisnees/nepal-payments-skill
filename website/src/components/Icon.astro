---
// Hugeicons stroke set (src/lib/hugeicons.ts), currentColor, rendered at build time.
import { iconInner, type IconName } from "../lib/hugeicons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={iconInner(name)} />
