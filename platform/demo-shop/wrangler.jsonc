{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "paynp-demo-shop",
  "account_id": "8886776a39863c14da28dfc1d5cb74c3", // nepali-payment
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  // nodejs_compat puts vars in process.env, which the eSewa module reads.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "paynp-shop.discerns.app", "custom_domain": true }],
  // Shares the paynp database (the free plan caps the number of databases); every table is prefixed shop_.
  "d1_databases": [{ "binding": "DB", "database_name": "paynp", "database_id": "60de52b7-fc41-4c9a-8a42-e54054ab0087", "migrations_dir": "migrations", "migrations_table": "shop_migrations" }],
  // Events go straight to the paynp Worker instead of a public round trip.
  "services": [{ "binding": "PAYNP", "service": "paynp" }],
  // Every minute: confirm payments where the buyer never came back.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // eSewa's public sandbox credentials (EPAYTEST), from its developer docs. Not secrets.
    "ESEWA_ENV": "sandbox",
    "ESEWA_PRODUCT_CODE": "EPAYTEST",
    "ESEWA_SECRET_KEY": "8gBm/:&EnhH.1/q",
    "KHALTI_ENV": "sandbox",
    "KHALTI_WEBSITE_URL": "https://paynp-shop.discerns.app",
    "PAYNP_ENDPOINT": "https://discerns.app",
    "DASHBOARD_URL": "https://discerns.app/p/prj_01M6N90FHB6ZDRKXSF0QPKCCQC/test/payments"
  }
  // Secrets: PAYNP_KEY (a pnp_test_ key of the paynp-demo project), PAYNP_WEBHOOK_SECRET (its webhook endpoint's
  // whsec_ secret), KHALTI_SECRET_KEY (Khalti sandbox).
}
