{
  "name": "paynp-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "worker",
    "dashboard",
    "sdk-ts",
    "cli",
    "demo-shop",
    "status"
  ],
  "scripts": {
    "dev": "npm run dev --workspace worker",
