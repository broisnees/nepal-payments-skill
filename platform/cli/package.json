{
  "name": "paynp",
  "version": "0.1.0",
  "description": "paynp CLI: sign in, link a project, wire the SDK and tail payment events live.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "paynp": "./dist/paynp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && npm run build:dashboard",
    "build:dashboard": "cd ../dashboard && vite build --outDir ../cli/dist/dashboard --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/types": "7.29.11",
    "@types/node": "22.20.5",
    "magic-string": "1.4.5",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
