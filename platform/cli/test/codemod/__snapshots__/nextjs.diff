+import * as esewa from "./esewa";
+
+export const paynp = createPaynp({ key: process.env.PAYNP_KEY });
+export const gateway = paynp.wrapGateway("esewa", esewa);
+
+// To find payments by the buyer's phone or email in the dashboard, pass who paid (paynp keeps both only hashed):
+// export const gateway = paynp.wrapGateway("esewa", esewa, { customer: (input) => ({ phone: input.phone, email: input.email }) });

