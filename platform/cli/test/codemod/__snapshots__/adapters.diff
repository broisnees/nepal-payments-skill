+// Reports every payment step of the nepal-payments adapters to paynp: initiate, verify, errors.
+// Written by `paynp init`. Same exports as "./payments/index.ts", with every adapter wrapped.
+import { createPaynp } from "@paynp/sdk";
+import * as lib from "./payments/index.ts";
+
+export * from "./payments/index.ts";
+
+export const paynp = createPaynp({ key: process.env.PAYNP_KEY });
+
+export const esewa = (...args: Parameters<typeof lib.esewa>) => paynp.wrapAdapter(lib.esewa(...args));
+export const khalti = (...args: Parameters<typeof lib.khalti>) => paynp.wrapAdapter(lib.khalti(...args));
+export const fonepay = (...args: Parameters<typeof lib.fonepay>) => paynp.wrapAdapter(lib.fonepay(...args));
+export const connectips = (...args: Parameters<typeof lib.connectips>) => paynp.wrapAdapter(lib.connectips(...args));
+export const cybersource = (...args: Parameters<typeof lib.cybersource>) => paynp.wrapAdapter(lib.cybersource(...args));
+export const nps = (...args: Parameters<typeof lib.nps>) => paynp.wrapAdapter(lib.nps(...args));
+export const imepay = (...args: Parameters<typeof lib.imepay>) => paynp.wrapAdapter(lib.imepay(...args));
+export const nepalpay = (...args: Parameters<typeof lib.nepalpay>) => paynp.wrapAdapter(lib.nepalpay(...args));
+
+export function createPayments(cfg: lib.PaymentsConfig): ReturnType<typeof lib.createPayments> {
+  const payments = lib.createPayments(cfg);
+  return {
+    ...payments,
+    get: (id) => paynp.wrapAdapter(payments.get(id)),
+    adapter: (id) => paynp.wrapAdapter(payments.adapter(id)),
+  };
+}
+
+// To find payments by the buyer's phone or email in the dashboard, pass who paid (paynp keeps both only hashed):
+// paynp.wrapAdapter(adapter, { customer: (input) => input.customer });

